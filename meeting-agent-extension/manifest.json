{
  "manifest_version": 3,
  "name": "BBC Meeting Agent",
  "version": "0.1.0",
  "description": "Listens to your Google Meet, writes notes in Arabic and English, and turns action items into BBC tasks.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "BBC Meeting Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabCapture", "offscreen", "storage", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "116"
}
